<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeveloperIsland.UI.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:DeveloperIsland.UI">

    <Grid x:Name="Root">
        <Grid.Resources>
            <ResourceDictionary Source="ms-appx:///UI/Theme/SettingsTheme.xaml" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Padding="12,0,12,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="TitleArea" Orientation="Horizontal" Spacing="10" Padding="8,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/DeveloperIsland-256.png" Width="20" Height="20" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock ui:LocText.TextKey="AppName" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource SettingsTextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="2" x:Name="Nav" AutomationProperties.Name="Settings sections">
                <Button x:Name="NavGeneral" AutomationProperties.Name="General" Style="{StaticResource SettingsNavButtonStyle}" Tag="General" Click="OnNav">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE713;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <TextBlock ui:LocText.TextKey="SettingsGeneral" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavPosition" AutomationProperties.Name="Position" Style="{StaticResource SettingsNavButtonStyle}" Tag="Position" Click="OnNav">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7F4;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <TextBlock ui:LocText.TextKey="SettingsPosition" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavModules" AutomationProperties.Name="Modules" Style="{StaticResource SettingsNavButtonStyle}" Tag="Modules" Click="OnNav">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE74C;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <TextBlock ui:LocText.TextKey="SettingsModules" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavHomeCloud" AutomationProperties.Name="Home Cloud" Style="{StaticResource SettingsNavButtonStyle}" Tag="HomeCloud" Click="OnNav">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE753;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <TextBlock ui:LocText.TextKey="SettingsHomeCloud" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavAppearance" AutomationProperties.Name="Appearance" Style="{StaticResource SettingsNavButtonStyle}" Tag="Appearance" Click="OnNav">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE790;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <TextBlock ui:LocText.TextKey="SettingsAppearance" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavAbout" AutomationProperties.Name="About" Style="{StaticResource SettingsNavButtonStyle}" Tag="About" Click="OnNav">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE946;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <TextBlock ui:LocText.TextKey="SettingsAbout" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="DragArea" Background="Transparent" />
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="32,0,36,32" HorizontalScrollMode="Disabled">
                <Grid MaxWidth="620" HorizontalAlignment="Stretch">

                    <!-- General -->
                    <StackPanel x:Name="GeneralSection" Spacing="8">
                        <TextBlock ui:LocText.TextKey="SettingsGeneral" Style="{StaticResource SettingsTitleStyle}" Margin="0,0,0,20" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsStartWithWindows" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock ui:LocText.TextKey="SettingsStartWithWindowsDescription" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartWithWindowsToggle" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                  AutomationProperties.Name="Start with Windows" Toggled="OnToggle" Tag="StartWithWindows" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsAlwaysOnTop" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock ui:LocText.TextKey="SettingsAlwaysOnTopDescription" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AlwaysOnTopToggle" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                  AutomationProperties.Name="Always on top" Toggled="OnToggle" Tag="AlwaysOnTop" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsLaunchHidden" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock ui:LocText.TextKey="SettingsLaunchHiddenDescription" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LaunchHiddenToggle" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                  AutomationProperties.Name="Launch hidden" Toggled="OnToggle" Tag="LaunchHidden" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock ui:LocText.TextKey="SettingsShortcut" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock x:Name="ShortcutText" ui:LocText.TextKey="SettingsShortcutDescription" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <ComboBox x:Name="ShortcutPicker" MinWidth="176" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Keyboard shortcut keys" SelectionChanged="OnShortcutChanged" />
                                    <ToggleSwitch x:Name="ShortcutToggle" Style="{StaticResource SettingsToggleStyle}"
                                                  AutomationProperties.Name="Keyboard shortcut" Toggled="OnToggle" Tag="Shortcut" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Updates: the one network request of the app's own, off until the user turns it on. -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock ui:LocText.TextKey="SettingsCheckForUpdates" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock ui:LocText.TextKey="SettingsCheckForUpdatesDescription"
                                                   Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="UpdatesToggle" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                  AutomationProperties.Name="Check for updates" Toggled="OnToggle" Tag="CheckForUpdates" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock x:Name="UpdateStatusTitle" Style="{StaticResource SettingsRowTitleStyle}" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <Button x:Name="UpdateInstallButton" Grid.Column="1" Content="Install…" VerticalAlignment="Center" Visibility="Collapsed"
                                            Style="{StaticResource AccentButtonStyle}" Click="OnOpenUpdate" AutomationProperties.Name="Install the available update" />
                                    <Button x:Name="UpdateCheckButton" Grid.Column="2" Content="Check now" VerticalAlignment="Center" Click="OnCheckForUpdates" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Quit the whole app. Two steps (button, then Quit in the flyout), so it never happens by accident. -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,0">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock ui:LocText.TextKey="SettingsQuit" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock ui:LocText.TextKey="SettingsQuitDescription"
                                               Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>
                                <Button x:Name="QuitButton" Grid.Column="1" Content="Quit…" VerticalAlignment="Center"
                                        AutomationProperties.Name="Quit Developer Island">
                                    <Button.Flyout>
                                        <Flyout x:Name="QuitFlyout" Placement="BottomEdgeAlignedRight">
                                            <StackPanel Spacing="12" MaxWidth="280">
                                                <StackPanel Spacing="4">
                                                    <TextBlock ui:LocText.TextKey="SettingsQuitConfirm" Style="{StaticResource SettingsRowTitleStyle}" FontWeight="SemiBold" />
                                                    <TextBlock ui:LocText.TextKey="SettingsQuitConfirmDescription"
                                                               Style="{StaticResource SettingsRowDescriptionStyle}" />
                                                </StackPanel>
                                                <Button x:Name="ConfirmQuitButton" Content="Quit" HorizontalAlignment="Right" MinWidth="88" Click="OnConfirmQuit"
                                                        AutomationProperties.Name="Quit Developer Island now">
                                                    <!-- Destructive action: the system's critical red in both themes. -->
                                                    <Button.Resources>
                                                        <SolidColorBrush x:Key="ButtonBackground" Color="#FFC42B1C" />
                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFB02719" />
                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF9C2216" />
                                                        <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
                                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E6FFFFFF" />
                                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Position -->
                    <StackPanel x:Name="PositionSection" Spacing="8" Visibility="Collapsed">
                        <TextBlock ui:LocText.TextKey="SettingsPosition" Style="{StaticResource SettingsTitleStyle}" Margin="0,0,0,20" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsMonitor" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock ui:LocText.TextKey="SettingsMonitorHint" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="MonitorPicker" Grid.Column="1" MinWidth="220" VerticalAlignment="Center"
                                              AutomationProperties.Name="Monitor" SelectionChanged="OnMonitorChanged" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}" Padding="16,16,16,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsAnchor" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock ui:LocText.TextKey="SettingsAnchorHint" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        <TextBlock x:Name="AnchorName" Style="{StaticResource SettingsRowDescriptionStyle}" Foreground="{ThemeResource SettingsTextPrimaryBrush}" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <!-- Miniature screen with the six anchors. -->
                                    <Border Grid.Column="1" Width="184" Height="116" CornerRadius="10" BorderThickness="1"
                                            Background="{ThemeResource SettingsScreenBrush}" BorderBrush="{ThemeResource SettingsScreenStrokeBrush}">
                                        <Grid x:Name="AnchorGrid" Padding="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <RadioButton x:Name="AnchorTopLeft" GroupName="Anchor" Style="{StaticResource AnchorPickerButtonStyle}" Tag="TopLeft"
                                                         HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Top Left" Checked="OnAnchorChecked" />
                                            <RadioButton x:Name="AnchorTopCenter" Grid.Column="1" GroupName="Anchor" Style="{StaticResource AnchorPickerButtonStyle}" Tag="TopCenter"
                                                         HorizontalAlignment="Center" VerticalAlignment="Top" AutomationProperties.Name="Top Center" Checked="OnAnchorChecked" />
                                            <RadioButton x:Name="AnchorTopRight" Grid.Column="2" GroupName="Anchor" Style="{StaticResource AnchorPickerButtonStyle}" Tag="TopRight"
                                                         HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Top Right" Checked="OnAnchorChecked" />
                                            <RadioButton x:Name="AnchorBottomLeft" Grid.Row="1" GroupName="Anchor" Style="{StaticResource AnchorPickerButtonStyle}" Tag="BottomLeft"
                                                         HorizontalAlignment="Left" VerticalAlignment="Bottom" AutomationProperties.Name="Bottom Left" Checked="OnAnchorChecked" />
                                            <RadioButton x:Name="AnchorBottomCenter" Grid.Row="1" Grid.Column="1" GroupName="Anchor" Style="{StaticResource AnchorPickerButtonStyle}" Tag="BottomCenter"
                                                         HorizontalAlignment="Center" VerticalAlignment="Bottom" AutomationProperties.Name="Bottom Center" Checked="OnAnchorChecked" />
                                            <RadioButton x:Name="AnchorBottomRight" Grid.Row="1" Grid.Column="2" GroupName="Anchor" Style="{StaticResource AnchorPickerButtonStyle}" Tag="BottomRight"
                                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" AutomationProperties.Name="Bottom Right" Checked="OnAnchorChecked" />
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsCustomPosition" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock x:Name="CustomPositionText" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <Button x:Name="ResetPositionButton" Grid.Column="1" Content="Reset Position" Click="OnResetPosition" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock ui:LocText.TextKey="SettingsAutoHide" Style="{StaticResource SettingsGroupLabelStyle}" Margin="4,20,0,4" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsAutoHideStepAside" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock x:Name="SmartHideText" ui:LocText.TextKey="SettingsAutoHideDescription" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SmartHideToggle" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                  AutomationProperties.Name="Step aside for these apps" Toggled="OnToggle" Tag="SmartHide" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsAutoHideBehavior" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock ui:LocText.TextKey="SettingsAutoHideBehaviorHint" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="8" Padding="2" Background="{ThemeResource SettingsSegmentBrush}">
                                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="Auto-hide behavior">
                                            <RadioButton x:Name="SmartHideRetract" GroupName="SmartHideBehavior" Style="{StaticResource SegmentedOptionStyle}" Content="Notch" Tag="Retract" Checked="OnSmartHideBehaviorChecked" />
                                            <RadioButton x:Name="SmartHideHide" GroupName="SmartHideBehavior" Style="{StaticResource SegmentedOptionStyle}" Content="Hide" Tag="Hide" Checked="OnSmartHideBehaviorChecked" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsOnlyMaximized" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock ui:LocText.TextKey="SettingsOnlyMaximizedHint" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutoHideMaximizedToggle" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                  AutomationProperties.Name="Only when maximized" Toggled="OnToggle" Tag="AutoHideMaximized" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,8,0,0">
                            <StackPanel>
                                <StackPanel x:Name="AutoHideRows" AutomationProperties.Name="Apps" />
                                <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock ui:LocText.TextKey="SettingsAddApp" Style="{StaticResource SettingsRowDescriptionStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button x:Name="AddAppButton" Grid.Column="1" Content="Add application…" Click="OnAddApplication" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Browse…" Click="OnBrowseApplication" VerticalAlignment="Center"
                                            AutomationProperties.Name="Browse for an executable" ToolTipService.ToolTip="Browse executable…" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Home Cloud -->
                    <StackPanel x:Name="HomeCloudSection" Spacing="8" Visibility="Collapsed">
                        <TextBlock ui:LocText.TextKey="SettingsHomeCloud" Style="{StaticResource SettingsTitleStyle}" Margin="0,0,0,4" />
                        <TextBlock ui:LocText.TextKey="SettingsHomeCloudHint" Style="{StaticResource SettingsRowDescriptionStyle}" Margin="0,0,0,16" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsEnableDropZone" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock ui:LocText.TextKey="SettingsEnableDropZoneHint" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="HomeCloudToggle" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                  AutomationProperties.Name="Enable drop zone" Toggled="OnHomeCloudToggled" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsTargetFolder" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock ui:LocText.TextKey="SettingsTargetFolderHint" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="HomeCloudPathBox" Grid.Column="1" MinWidth="240" VerticalAlignment="Center" PlaceholderText="\\server\share\Inbox"
                                             AutomationProperties.Name="Home Cloud target folder" LostFocus="OnHomeCloudPathLostFocus" KeyDown="OnHomeCloudPathKeyDown" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsDropZoneSide" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock ui:LocText.TextKey="SettingsDropZoneSideHint" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="8" Padding="2" Background="{ThemeResource SettingsSegmentBrush}">
                                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="Drop zone side">
                                            <RadioButton x:Name="HomeCloudSideLeft" GroupName="HomeCloudSide" Style="{StaticResource SegmentedOptionStyle}" Content="Left" Tag="Left" Checked="OnHomeCloudSideChecked" />
                                            <RadioButton x:Name="HomeCloudSideRight" GroupName="HomeCloudSide" Style="{StaticResource SegmentedOptionStyle}" Content="Right" Tag="Right" Checked="OnHomeCloudSideChecked" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HomeCloudStatus" ui:LocText.TextKey="SettingsCheckTargetFolder" Style="{StaticResource SettingsRowDescriptionStyle}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <Button x:Name="HomeCloudTestButton" Grid.Column="1" Content="Test connection" Click="OnHomeCloudTest" VerticalAlignment="Center" />
                                    <Button x:Name="HomeCloudOpenButton" Grid.Column="2" Content="Open folder" Click="OnHomeCloudOpen" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- Modules -->
                    <StackPanel x:Name="ModulesSection" Spacing="8" Visibility="Collapsed">
                        <TextBlock ui:LocText.TextKey="SettingsModules" Style="{StaticResource SettingsTitleStyle}" Margin="0,0,0,4" />
                        <TextBlock ui:LocText.TextKey="SettingsModulesHint" Style="{StaticResource SettingsRowDescriptionStyle}" Margin="0,0,0,16" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel x:Name="ModuleRows" AutomationProperties.Name="Modules" />
                        </Border>

                        <TextBlock ui:LocText.TextKey="SettingsClaudeCodeAndCodex" Style="{StaticResource SettingsGroupLabelStyle}" Margin="4,20,0,4" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock ui:LocText.TextKey="SettingsTokenMetric" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock ui:LocText.TextKey="SettingsTokenMetricHint"
                                               Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="8" Padding="2" Background="{ThemeResource SettingsSegmentBrush}">
                                    <StackPanel Orientation="Horizontal" AutomationProperties.Name="Token metric">
                                        <RadioButton x:Name="TokenMetricFresh" GroupName="TokenMetric" Style="{StaticResource SegmentedOptionStyle}" Content="Fresh" Tag="Fresh" Checked="OnTokenMetricChecked" />
                                        <RadioButton x:Name="TokenMetricAll" GroupName="TokenMetric" Style="{StaticResource SegmentedOptionStyle}" Content="All processed" Tag="AllProcessed" Checked="OnTokenMetricChecked" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock ui:LocText.TextKey="SettingsClaudePlanUsage" Style="{StaticResource SettingsGroupLabelStyle}" Margin="4,20,0,4" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="PlanStatusTitle" ui:LocText.TextKey="SettingsNotConnected" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock x:Name="PlanStatusText" Style="{StaticResource SettingsRowDescriptionStyle}"
                                               ui:LocText.TextKey="SettingsClaudePlanUsageHint" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="PlanConnectButton" Content="Connect" Click="OnConnectPlan" />
                                    <Button x:Name="PlanDisconnectButton" Content="Disconnect" Click="OnDisconnectPlan" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock ui:LocText.TextKey="SettingsWhisperFlow" Style="{StaticResource SettingsGroupLabelStyle}" Margin="4,20,0,4" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock ui:LocText.TextKey="SettingsShowDictation" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock x:Name="WhisperFlowStatusText" Style="{StaticResource SettingsRowDescriptionStyle}" Text="" />
                                </StackPanel>
                                <ToggleSwitch x:Name="WhisperFlowToggle" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                              AutomationProperties.Name="Show WhisperFlow dictation" Toggled="OnToggle" Tag="WhisperFlow" />
                            </Grid>
                        </Border>

                        <TextBlock ui:LocText.TextKey="ModuleAwake" Style="{StaticResource SettingsGroupLabelStyle}" Margin="4,20,0,4" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock ui:LocText.TextKey="SettingsEndOnLowBattery" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock ui:LocText.TextKey="SettingsOnBattery"
                                               Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="AwakeBatteryPicker" Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                                          AutomationProperties.Name="End an awake session on battery below" SelectionChanged="OnAwakeBatteryChanged" />
                            </Grid>
                        </Border>

                        <TextBlock ui:LocText.TextKey="SettingsGitRepositories" Style="{StaticResource SettingsGroupLabelStyle}" Margin="4,20,0,4" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <StackPanel x:Name="RepoRows" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock ui:LocText.TextKey="SettingsGitRepositoriesHint"
                                               Style="{StaticResource SettingsRowDescriptionStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Button Grid.Column="1" Content="Add repository…" Click="OnAddRepository" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock ui:LocText.TextKey="SettingsCalendars" Style="{StaticResource SettingsGroupLabelStyle}" Margin="4,20,0,4" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <StackPanel x:Name="CalendarRows" />
                                <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CalendarLinkBox" PlaceholderText="Paste a calendar link in iCal format (https:// or webcal://)"
                                             AutomationProperties.Name="Calendar link" KeyDown="OnCalendarLinkKeyDown" TextChanged="OnCalendarLinkChanged" />
                                    <Button x:Name="AddCalendarButton" Grid.Column="1" Content="Add" Click="OnAddCalendarLink" IsEnabled="False" />
                                </Grid>
                                <Grid Style="{StaticResource SettingsRowStyle}" Padding="16,0,12,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock ui:LocText.TextKey="SettingsCalendarsHint"
                                               Style="{StaticResource SettingsRowDescriptionStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Button Grid.Column="1" Content="Add .ics file…" Click="OnAddCalendarFile" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--
                            Weather and markets are configured here rather than inside the island: both
                            take free-text input, and typing a city or a list of symbols into a capsule
                            that retracts on hover is the wrong shape for that. The panel only shows
                            the result.
                        -->
                        <TextBlock ui:LocText.TextKey="SettingsWeatherAndMarkets" Style="{StaticResource SettingsGroupLabelStyle}" Margin="4,20,0,4" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock ui:LocText.TextKey="SettingsWeatherCity" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock ui:LocText.TextKey="SettingsWeatherCityHint" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="WeatherCityBox" Grid.Column="1" VerticalAlignment="Center"
                                             PlaceholderText="杭州" TextChanged="OnWeatherCityChanged" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock ui:LocText.TextKey="SettingsMarketSymbols" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock ui:LocText.TextKey="SettingsMarketSymbolsHint" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="MarketSymbolsBox" Grid.Column="1" VerticalAlignment="Center"
                                             PlaceholderText="sh600519,sz000001,usAAPL" TextChanged="OnMarketSymbolsChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Appearance -->
                    <StackPanel x:Name="AppearanceSection" Spacing="8" Visibility="Collapsed">
                        <TextBlock ui:LocText.TextKey="SettingsAppearance" Style="{StaticResource SettingsTitleStyle}" Margin="0,0,0,20" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsTheme" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock ui:LocText.TextKey="SettingsThemeDescription" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="8" Padding="2" Background="{ThemeResource SettingsSegmentBrush}">
                                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="Theme">
                                            <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource SegmentedOptionStyle}" Content="System" Tag="System" Checked="OnThemeChecked" />
                                            <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource SegmentedOptionStyle}" Content="Dark" Tag="Dark" Checked="OnThemeChecked" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="LanguageTitle" ui:LocText.TextKey="SettingsLanguage" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock x:Name="LanguageDescription" ui:LocText.TextKey="SettingsLanguageDescription" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="8" Padding="2" Background="{ThemeResource SettingsSegmentBrush}">
                                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="Language">
                                            <RadioButton x:Name="LanguageSystem" GroupName="Language" Style="{StaticResource SegmentedOptionStyle}" Content="Same as Windows" Tag="System" Checked="OnLanguageChecked" />
                                            <RadioButton x:Name="LanguageEnglish" GroupName="Language" Style="{StaticResource SegmentedOptionStyle}" Content="English" Tag="English" Checked="OnLanguageChecked" />
                                            <RadioButton x:Name="LanguageChinese" GroupName="Language" Style="{StaticResource SegmentedOptionStyle}" Content="简体中文" Tag="ChineseSimplified" Checked="OnLanguageChecked" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- About -->
                    <StackPanel x:Name="AboutSection" Spacing="8" Visibility="Collapsed">
                        <TextBlock ui:LocText.TextKey="SettingsAbout" Style="{StaticResource SettingsTitleStyle}" Margin="0,0,0,20" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="ms-appx:///Assets/DeveloperIsland-256.png" Width="44" Height="44" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="AppName" Style="{StaticResource SettingsRowTitleStyle}" FontWeight="SemiBold" />
                                        <TextBlock x:Name="VersionText" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsLocalFirst" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock Style="{StaticResource SettingsRowDescriptionStyle}"
                                                   ui:LocText.TextKey="SettingsPrivacyBody" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsDataAndLogs" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock x:Name="DataPathText" Style="{StaticResource SettingsRowDescriptionStyle}" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Open Folder" Click="OnOpenDataFolder" VerticalAlignment="Center" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock ui:LocText.TextKey="SettingsApiEquivalent" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock Style="{StaticResource SettingsRowDescriptionStyle}"
                                                   ui:LocText.TextKey="SettingsApiEquivalentHint" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
